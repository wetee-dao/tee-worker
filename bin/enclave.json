{
    "exe": "./manager",
    "key": "./keys/private.pem",
    "debug": true,
    "heapSize": 512,
    "executableHeap": false,
    "productID": 1,
    "securityVersion": 1,
    "mounts": [
        {
            "source": "/var/run/secrets/kubernetes.io/serviceaccount/",
            "target": "/var/run/secrets/kubernetes.io/serviceaccount/",
            "type": "hostfs",
            "readOnly": true
        },
        {
            "source": "/opt/wetee-worker",
            "target": "/chain_data",
            "type": "hostfs",
            "readOnly": false
        }
    ],
    "env": [
        {
            "name": "KUBECONFIG",
            "fromHost": true
        },
        {
            "name": "KUBERNETES_SERVICE_HOST",
            "fromHost": true
        },
        {
            "name": "KUBERNETES_SERVICE_PORT",
            "fromHost": true
        },
        {
            "name": "SIDE_CHAIN_PORT",
            "fromHost": true
        },
        {
            "name": "SIDE_CHAIN_ADDR",
            "fromHost": true
        },
        {
            "name": "GQL_PORT",
            "fromHost": true
        },
        {
            "name": "CHAIN_ADDR",
            "fromHost": true
        },
        {
            "name": "PASSWORD",
            "fromHost": true
        }
    ],
    "files": [
        {
            "source": "/opt/kube/config",
            "target": "/etc/kube/config"
        },
        {
            "source": "/etc/ssl/certs/ca-certificates.crt",
            "target": "/etc/ssl/certs/ca-certificates.crt"
        }
    ]
}