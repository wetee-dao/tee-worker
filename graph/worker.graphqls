"""
Work type
"""
enum WorkType {
  """
  app
  """
  APP
  """
  task
  """
  TASK
}

extend type Query {
  """
  Query worker info
  """
  worker_info: WorkerInfo!
  """
  Query worker mint list
  """
  worker: [Contract!]! @AuthCheck(role: ADMIN)
}

type WorkerInfo {
  """
  Root user of worker
  """
  RootAddress: String!
  """
  Worker mint user
  """
  MintAddress: String!
  """
  Report
  """
  Report: String!
}

type Contract {
  """
  Start of block number
  """
  StartNumber: String!
  """
  User address
  """
  User: String!
  """
  Work id
  """
  WorkId: String!
}
